<Page
    x:Class="HaloMeister.App.Pages.ChangeBipedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Padding="24"
            HorizontalAlignment="Stretch"
            Spacing="18">

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{i18n:Loc Key='change_biped.change_character'}" />
                <Button
                    x:Name="ConnectScanButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OnConnectAndScan"
                    Content="{i18n:Loc Key='change_biped.scan_mission'}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <TextBlock
                HorizontalAlignment="Stretch"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{i18n:Loc Key='change_biped.switch_to_a_loaded_character_ai_bipeds_ma_7f6d33'}"
                TextWrapping="Wrap" />

            <Border
                Padding="16,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="GameStateDot"
                            Width="9"
                            Height="9"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='change_biped.game'}" />
                            <TextBlock x:Name="GameStateText" Text="{i18n:Loc Key='change_biped.disconnected'}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            x:Name="BridgeStateDot"
                            Width="9"
                            Height="9"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='change_biped.switch_bridge'}" />
                            <TextBlock x:Name="BridgeStateText" Text="{i18n:Loc Key='change_biped.not_ready'}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            x:Name="ScanStateDot"
                            Width="9"
                            Height="9"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='change_biped.mission_tags'}" />
                            <TextBlock x:Name="ScanStateText" Text="{i18n:Loc Key='change_biped.not_scanned'}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="BusyRing"
                            Width="22"
                            Height="22"
                            IsActive="False" />
                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            MinWidth="72"
                            Click="OnRefresh"
                            Content="{i18n:Loc Key='change_biped.refresh'}"
                            IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>

            <Grid
                Height="580"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="16,14,16,10" Spacing="8">
                            <Grid>
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{i18n:Loc Key='change_biped.mission_characters'}" />
                                <TextBlock
                                    x:Name="CountText"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBox
                                x:Name="SearchBox"
                                IsEnabled="False"
                                PlaceholderText="{i18n:Loc Key='change_biped.search_name_species_or_tag_path'}"
                                TextChanged="OnSearchChanged" />
                        </StackPanel>

                        <ListView
                            x:Name="BipedList"
                            Grid.Row="1"
                            IsItemClickEnabled="False"
                            SelectionChanged="OnBipedSelectionChanged"
                            SelectionMode="Single"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,4" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TagPath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="11"
                                                Text="{Binding Category}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{i18n:Loc Key='change_biped.character_overlay_title'}" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='change_biped.character_overlay_description'}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            Spacing="6">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{i18n:Loc Key='change_biped.third_person_variant'}" />
                            <ComboBox
                                x:Name="VariantPicker"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                UseLayoutRounding="True"
                                SelectionChanged="OnVariantChanged">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Padding" Value="12,8" />
                                        <Setter Property="UseLayoutRounding" Value="True" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            UseLayoutRounding="True" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button
                            x:Name="ApplyTagRedirectButton"
                            Grid.Row="3"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            Click="OnApplyTagRedirect"
                            Content="{i18n:Loc Key='change_biped.build_character_overlay'}"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />

                        <Grid
                            Grid.Row="4"
                            Margin="0,16,0,8"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{i18n:Loc Key='change_biped.character_overlay_list'}" />
                            <Button
                                x:Name="RefreshOverlaysButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                MinWidth="72"
                                Click="OnRefreshCharacterOverlays"
                                Content="{i18n:Loc Key='change_biped.refresh_character_overlays'}" />
                        </Grid>

                        <ListView
                            x:Name="CharacterOverlayList"
                            Grid.Row="5"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,6" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Status}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SourceUtocPath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Width="64"
                                                Click="OnInstallCharacterOverlay"
                                                Content="{i18n:Loc Key='change_biped.install_character_overlay_action'}"
                                                IsEnabled="{Binding CanInstall}"
                                                Tag="{Binding}" />
                                            <Button
                                                Width="64"
                                                Click="OnUninstallCharacterOverlay"
                                                Content="{i18n:Loc Key='change_biped.uninstall_character_overlay_action'}"
                                                IsEnabled="{Binding CanUninstall}"
                                                Tag="{Binding}" />
                                            <Button
                                                Width="64"
                                                Click="OnDeleteCharacterOverlay"
                                                Content="{i18n:Loc Key='change_biped.delete_character_overlay_action'}"
                                                IsEnabled="{Binding CanDelete}"
                                                Tag="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />

            <TextBlock
                x:Name="DiagnosticText"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
