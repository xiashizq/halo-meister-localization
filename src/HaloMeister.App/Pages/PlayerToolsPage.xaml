<Page
    x:Class="HaloMeister.App.Pages.PlayerToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='player_tools.player_tools'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='player_tools.move_the_player_control_the_camera_and_te_5b26bf'}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:Loc Key='player_tools.live_session'}" />
                    <TextBlock
                        x:Name="BridgeStatusText"
                        MaxWidth="360"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RefreshButton" Click="OnRefresh" Content="{i18n:Loc Key='player_tools.refresh_position'}" />
            </StackPanel>
        </Grid>

        <Pivot Grid.Row="1">
            <PivotItem Header="{i18n:Loc Key='player_tools.movement'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Padding="0,12,0,8" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource LiveToolCardStyle}" VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.no_clip'}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{i18n:Loc Key='player_tools.fly_while_keeping_the_camera_and_controll_8fd3c1'}" />
                                </StackPanel>
                                <Border Style="{StaticResource LiveToolInsetStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="13" Glyph="&#xE7BA;" />
                                        <TextBlock
                                            Style="{StaticResource CompactSafetyTextStyle}"
                                            Text="{i18n:Loc Key='player_tools.restore_normal_physics_before_saving_relo_bc48df'}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Button
                                        x:Name="EnableNoClipButton"
                                        Click="OnEnableNoClip"
                                        Content="{i18n:Loc Key='player_tools.enable_no_clip'}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="DisableNoClipButton"
                                        Click="OnDisableNoClip"
                                        Content="{i18n:Loc Key='player_tools.restore_physics'}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource LiveToolCardStyle}" VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.teleport'}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{i18n:Loc Key='player_tools.edit_the_current_blam_world_coordinates_k_c925d3'}" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="XBox" Header="{i18n:Loc Key='player_tools.x_coordinate'}" PlaceholderText="0" />
                                    <TextBox x:Name="YBox" Grid.Column="1" Header="{i18n:Loc Key='player_tools.y_coordinate'}" PlaceholderText="0" />
                                    <TextBox x:Name="ZBox" Grid.Column="2" Header="{i18n:Loc Key='player_tools.z_coordinate'}" PlaceholderText="0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Button x:Name="TeleportButton" Click="OnTeleport" Content="{i18n:Loc Key='player_tools.teleport'}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="SavePositionButton" Click="OnSavePosition" Content="{i18n:Loc Key='player_tools.save_return_point'}" />
                                    <Button x:Name="ReturnButton" Click="OnReturn" Content="{i18n:Loc Key='player_tools.return'}" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="SavedPositionText"
                                    Style="{StaticResource CompactSafetyTextStyle}"
                                    Text="{i18n:Loc Key='player_tools.no_return_point_saved'}" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="9">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.saved_locations'}" />
                                    <TextBlock
                                        Style="{StaticResource CompactSafetyTextStyle}"
                                        Text="{i18n:Loc Key='player_tools.named_locations_persist_between_halo_meis_4b4caa'}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="LocationNameBox"
                                            Header="{i18n:Loc Key='player_tools.location_name'}"
                                            PlaceholderText="{i18n:Loc Key='player_tools.bridge_overlook'}" />
                                        <Button
                                            x:Name="SaveLocationButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="OnSaveLocation"
                                            Content="{i18n:Loc Key='player_tools.save_current'}" />
                                    </Grid>
                                    <ComboBox
                                        x:Name="SavedLocationBox"
                                        DisplayMemberPath="Name"
                                        Header="{i18n:Loc Key='player_tools.saved_location'}"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="{i18n:Loc Key='player_tools.no_saved_locations'}"
                                        SelectionChanged="OnSavedLocationSelectionChanged" />
                                    <TextBlock
                                        x:Name="SavedLocationDetailText"
                                        Style="{StaticResource CompactSafetyTextStyle}"
                                        Text="{i18n:Loc Key='player_tools.no_saved_location_selected'}" />
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Button
                                            x:Name="TeleportSavedLocationButton"
                                            Click="OnTeleportSavedLocation"
                                            Content="{i18n:Loc Key='player_tools.teleport_here'}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            x:Name="DeleteSavedLocationButton"
                                            Click="OnDeleteSavedLocation"
                                            Content="{i18n:Loc Key='player_tools.delete'}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="{i18n:Loc Key='player_tools.camera'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Padding="0,12,0,8" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource LiveToolCardStyle}" VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.camera_input'}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{i18n:Loc Key='player_tools.freeze_player_movement_and_actions_while_509a91'}" />
                                </StackPanel>
                                <StackPanel Spacing="9">
                                    <Button
                                        x:Name="SuppressPlayerInputButton"
                                        HorizontalAlignment="Stretch"
                                        Click="OnSuppressPlayerInput"
                                        Content="{i18n:Loc Key='player_tools.suppress_player_input'}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="RestorePlayerInputButton"
                                        HorizontalAlignment="Stretch"
                                        Click="OnRestorePlayerInput"
                                        Content="{i18n:Loc Key='player_tools.restore_player_input'}" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource CompactSafetyTextStyle}"
                                    Text="{i18n:Loc Key='player_tools.this_is_separate_from_halo_s_native_machi_27df63'}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource LiveToolCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.third_person_camera'}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{i18n:Loc Key='player_tools.borrow_an_authored_unit_camera_or_define_393fda'}" />
                                </StackPanel>
                                <Border Style="{StaticResource LiveToolInsetStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="13" Glyph="&#xE7BA;" />
                                        <TextBlock
                                            Style="{StaticResource CompactSafetyTextStyle}"
                                            Text="{i18n:Loc Key='player_tools.applying_a_camera_enables_the_third_perso_227bb6'}" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="CameraPresetBox"
                                        DisplayMemberPath="Name"
                                        Header="{i18n:Loc Key='player_tools.loaded_camera_preset'}"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="{i18n:Loc Key='player_tools.refresh_to_find_loaded_unit_cameras'}"
                                        SelectionChanged="OnCameraPresetSelectionChanged" />
                                    <Button
                                        x:Name="RefreshCamerasButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Click="OnRefreshCameras"
                                        Content="{i18n:Loc Key='player_tools.find_cameras'}" />
                                    <Button
                                        x:Name="ApplyCameraPresetButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Click="OnApplyCameraPreset"
                                        Content="{i18n:Loc Key='player_tools.apply_preset'}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    x:Name="CameraPresetDetailText"
                                    Style="{StaticResource CompactSafetyTextStyle}"
                                    Text="{i18n:Loc Key='player_tools.no_camera_preset_selected'}" />

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.custom_camera'}" />
                                    <TextBlock
                                        Style="{StaticResource CompactSafetyTextStyle}"
                                        Text="{i18n:Loc Key='player_tools.offsets_are_local_to_the_player_s_authore_f9a36b'}" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CameraXBox" Header="{i18n:Loc Key='player_tools.local_x'}" PlaceholderText="0" />
                                    <TextBox x:Name="CameraYBox" Grid.Column="1" Header="{i18n:Loc Key='player_tools.local_y'}" PlaceholderText="0" />
                                    <TextBox x:Name="CameraZBox" Grid.Column="2" Header="{i18n:Loc Key='player_tools.local_z'}" PlaceholderText="0" />
                                    <TextBox x:Name="CameraFovBox" Grid.Column="3" Header="{i18n:Loc Key='player_tools.fov'}" PlaceholderText="70" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Button
                                        x:Name="ApplyCustomCameraButton"
                                        Click="OnApplyCustomCamera"
                                        Content="{i18n:Loc Key='player_tools.apply_custom_camera'}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="RestoreCameraButton"
                                        Click="OnRestoreCamera"
                                        Content="{i18n:Loc Key='player_tools.restore_authored_camera'}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="{i18n:Loc Key='player_tools.combat'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Padding="0,12,0,8" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource LiveToolCardStyle}" VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.immediate_weapon_actions'}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{i18n:Loc Key='player_tools.move_existing_weapon_animation_interrupti_cf983e'}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ImmediateWeaponInterruptionToggle"
                                    Header="{i18n:Loc Key='player_tools.weapon_animation_interruption'}"
                                    IsOn="False"
                                    OffContent="{i18n:Loc Key='player_tools.authored_timing'}"
                                    OnContent="{i18n:Loc Key='player_tools.immediate'}"
                                    Toggled="OnWeaponInterruptionToggled" />
                                <TextBlock
                                    Style="{StaticResource CompactSafetyTextStyle}"
                                    Text="{i18n:Loc Key='player_tools.turn_this_off_before_reloading_a_checkpoi_c653df'}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource LiveToolCardStyle}" VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{i18n:Loc Key='player_tools.super_punch'}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{i18n:Loc Key='player_tools.multiply_melee_acceleration_so_movable_ob_275450'}" />
                                </StackPanel>
                                <ComboBox x:Name="SuperPunchStrengthBox" Header="{i18n:Loc Key='player_tools.punch_strength'}" SelectedIndex="2">
                                    <ComboBoxItem Content="{i18n:Loc Key='player_tools.10_strong'}" Tag="10" />
                                    <ComboBoxItem Content="{i18n:Loc Key='player_tools.25_huge'}" Tag="25" />
                                    <ComboBoxItem Content="{i18n:Loc Key='player_tools.50_across_the_map'}" Tag="50" />
                                    <ComboBoxItem Content="{i18n:Loc Key='player_tools.100_ridiculous'}" Tag="100" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Button
                                        x:Name="EnableSuperPunchButton"
                                        Click="OnEnableSuperPunch"
                                        Content="{i18n:Loc Key='player_tools.enable_super_punch'}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="RestoreSuperPunchButton"
                                        Click="OnRestoreSuperPunch"
                                        Content="{i18n:Loc Key='player_tools.restore_normal_punch'}"
                                        IsEnabled="False" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource CompactSafetyTextStyle}"
                                    Text="{i18n:Loc Key='player_tools.shared_melee_effects_used_by_enemies_or_o_c949cd'}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="{i18n:Loc Key='player_tools.character_scale'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Padding="0,12,0,8">
                        <Border
                            MaxWidth="760"
                            HorizontalAlignment="Left"
                            Style="{StaticResource LiveToolCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{i18n:Loc Key='player_tools.character_scale'}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{i18n:Loc Key='player_tools.character_scale_desc'}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Style="{StaticResource LiveToolInsetStyle}">
                                    <TextBlock
                                        Style="{StaticResource CompactSafetyTextStyle}"
                                        Text="{i18n:Loc Key='player_tools.character_scale_warning'}"
                                        TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <ComboBox
                                        x:Name="PlayerScaleBox"
                                        MinWidth="150"
                                        Header="{i18n:Loc Key='player_tools.scale'}"
                                        SelectedIndex="3">
                                        <ComboBoxItem Content="0.25×" Tag="0.25" />
                                        <ComboBoxItem Content="0.5×" Tag="0.5" />
                                        <ComboBoxItem Content="0.75×" Tag="0.75" />
                                        <ComboBoxItem Content="1×" Tag="1" />
                                    </ComboBox>
                                    <Button
                                        x:Name="ApplyPlayerScaleButton"
                                        VerticalAlignment="Bottom"
                                        Click="OnApplyPlayerScale"
                                        Content="{i18n:Loc Key='player_tools.apply_scale'}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="RestorePlayerScaleButton"
                                        VerticalAlignment="Bottom"
                                        Click="OnRestorePlayerScale"
                                        Content="{i18n:Loc Key='player_tools.restore_scale'}" />
                                    <Button
                                        x:Name="ApplyPrimaryWeaponScaleButton"
                                        VerticalAlignment="Bottom"
                                        Click="OnApplyPrimaryWeaponScale"
                                        Content="{i18n:Loc Key='player_tools.apply_primary_weapon_scale'}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
            <TextBlock
                x:Name="SummaryText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{i18n:Loc Key='player_tools.connect_to_a_running_mission_to_begin'}" />
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" />
    </Grid>
</Page>
